{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Termflow Terminal Evaluation",
  "version": "0.1.0",
  "identifier": "com.termflow.terminal-eval",
  "build": { "frontendDist": "dist" },
  "app": {
    "windows": [{ "label": "main", "title": "Termflow xterm WebView Evaluation", "width": 950, "height": 680 }],
    "security": {
      "capabilities": [{ "identifier": "eval-main", "windows": ["main"], "permissions": ["core:event:allow-listen", "core:event:allow-unlisten"] }],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false, "icon": ["../../src-tauri/icons/icon.ico"] }
}
